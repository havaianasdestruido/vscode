  "head": {
   "ref": "fix/action-list-icon-aria-hidden",
   "sha": "7ce6f48496d2f08261f708d465590629eda04387",
   "repo": "DivyaRaval1909/vscode",
   "label": "DivyaRaval1909:fix/action-list-icon-aria-hidden"
