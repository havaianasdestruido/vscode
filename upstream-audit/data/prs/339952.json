  {
   "sha": "feea3ec8164d97c9279cb245179acf0cb62f82bb",
   "filename": "src/vs/platform/actionWidget/browser/actionList.ts",
   "status": "modified",
   "additions": 2,
   "deletions": 0,
   "changes": 2,
   "blob_url": "https://github.com/microsoft/vscode/blob/7ce6f48496d2f08261f708d465590629eda04387/src%2Fvs%2Fplatform%2FactionWidget%2Fbrowser%2FactionList.ts",
   "raw_url": "https://github.com/microsoft/vscode/raw/7ce6f48496d2f08261f708d465590629eda04387/src%2Fvs%2Fplatform%2FactionWidget%2Fbrowser%2FactionList.ts",
   "contents_url": "https://api.github.com/repos/microsoft/vscode/contents/src%2Fvs%2Fplatform%2FactionWidget%2Fbrowser%2FactionList.ts?ref=7ce6f48496d2f08261f708d465590629eda04387",
   "patch": "@@ -408,6 +408,7 @@ class ActionItemRenderer<T> implements IListRenderer<IActionListItem<T>, IAction\n \n \t\tconst icon = document.createElement('div');\n \t\ticon.className = 'icon';\n+\t\ticon.ariaHidden = 'true';\n \t\tcontainer.append(icon);\n \n \t\tconst labelIcon = dom.append(container, dom.$('span.action-list-label-icon', { 'aria-hidden': 'true' }));\n@@ -442,6 +443,7 @@ class ActionItemRenderer<T> implements IListRenderer<IActionListItem<T>, IAction\n \n \t\tconst submenuIndicator = document.createElement('div');\n \t\tsubmenuIndicator.className = 'action-list-submenu-indicator';\n+\t\tsubmenuIndicator.ariaHidden = 'true';\n \t\tcontainer.append(submenuIndicator);\n \n \t\tconst inlineToggleContainer = document.createElement('div');"
  },
  {
   "sha": "d31bbb34977a4a8e123b76e823914bfd5ac650e1",
   "filename": "src/vs/platform/actionWidget/test/browser/actionList.test.ts",
   "status": "modified",
   "additions": 19,
   "deletions": 0,
   "changes": 19,
   "blob_url": "https://github.com/microsoft/vscode/blob/7ce6f48496d2f08261f708d465590629eda04387/src%2Fvs%2Fplatform%2FactionWidget%2Ftest%2Fbrowser%2FactionList.test.ts",
   "raw_url": "https://github.com/microsoft/vscode/raw/7ce6f48496d2f08261f708d465590629eda04387/src%2Fvs%2Fplatform%2FactionWidget%2Ftest%2Fbrowser%2FactionList.test.ts",
   "contents_url": "https://api.github.com/repos/microsoft/vscode/contents/src%2Fvs%2Fplatform%2FactionWidget%2Ftest%2Fbrowser%2FactionList.test.ts?ref=7ce6f48496d2f08261f708d465590629eda04387",
   "patch": "@@ -4560,4 +4560,23 @@ suite('ActionListWidget', () => {\n \t\tassert.strictEqual(widget.getFocusedElement()?.item?.id, 'match-first');\n \t});\n \n+\ttest('action item icon and submenu indicator have aria-hidden=\"true\"', () => {\n+\t\tconst widget = createActionListWidget(disposables, {\n+\t\t\titems: [\n+\t\t\t\t{\n+\t\t\t\t\t...action('branch-item'),\n+\t\t\t\t\tgroup: { title: 'Branches', icon: Codicon.gitBranch },\n+\t\t\t\t\tsubmenuActions: [toAction({ id: 'action', label: 'Action', run: () => { } })],\n+\t\t\t\t},\n+\t\t\t],\n+\t\t\tlistOptions: { showFilter: false },\n+\t\t});\n+\n+\t\tconst icon = widget.domNode.querySelector<HTMLElement>('.monaco-list-row > .codicon:not(.action-list-submenu-indicator)');\n+\t\tconst submenuIndicator = widget.domNode.querySelector<HTMLElement>('.monaco-list-row .action-list-submenu-indicator');\n+\n+\t\tassert.strictEqual(icon?.getAttribute('aria-hidden'), 'true');\n+\t\tassert.strictEqual(submenuIndicator?.getAttribute('aria-hidden'), 'true');\n+\t});\n+\n });"
  }
 ],
