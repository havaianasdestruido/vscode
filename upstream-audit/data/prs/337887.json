   "blob_url": "https://github.com/microsoft/vscode/blob/82f1ebc0b690f6cab54d23aab931316ed7693399/src%2Fvs%2Fplatform%2FagentHost%2Fnode%2Fclaude%2Froadmap.md",
   "raw_url": "https://github.com/microsoft/vscode/raw/82f1ebc0b690f6cab54d23aab931316ed7693399/src%2Fvs%2Fplatform%2FagentHost%2Fnode%2Fclaude%2Froadmap.md",
