  "requested_reviewers": [],
  "head": {
   "ref": "bug-fix-accessibility",
   "sha": "52fa23e8f11fa6bf4759afd87b2721c4de2fc651",
   "repo": "nickbrit/vscode",
   "label": "nickbrit:bug-fix-accessibility"
  },
  "base": {
   "ref": "main",
   "sha": "043ceac535313b6b6523b7e5d373ef372b940cbe"
  },
  "body": "**Issue Associated:** https://github.com/microsoft/vscode/issues/245121\r\n\r\nFixed the accessibility hover and active states for activity bar icons in the high contrast theme.\r\n\r\n### Changes:\r\n\r\n- Replaced `::before` with a new `<div>` inside the `.action-item` container to handle the hover and active outline.\r\n- `::before` doesn’t work with CSS masks. It is used for outlines, while CSS masks are applied to extension icons, but they don’t work together.\r\n- Using an extra `<div>` ensures the outline is visible and works consistently across all icons.\r\n\r\n![ezgif-83798f5967789c](https://github.com/user-attachments/assets/d3dae506-8129-4b18-9d2b-d9130500bcfb)\r\n\r\n",
  "rebaseable": true
 },
 "files": [
  {
   "sha": "93e201d93162a0196538d14157b2fcb1423ff969",
   "filename": "src/vs/workbench/browser/parts/activitybar/activitybarPart.ts",
   "status": "modified",
   "additions": 9,
   "deletions": 7,
   "changes": 16,
   "blob_url": "https://github.com/microsoft/vscode/blob/52fa23e8f11fa6bf4759afd87b2721c4de2fc651/src%2Fvs%2Fworkbench%2Fbrowser%2Fparts%2Factivitybar%2FactivitybarPart.ts",
   "raw_url": "https://github.com/microsoft/vscode/raw/52fa23e8f11fa6bf4759afd87b2721c4de2fc651/src%2Fvs%2Fworkbench%2Fbrowser%2Fparts%2Factivitybar%2FactivitybarPart.ts",
   "contents_url": "https://api.github.com/repos/microsoft/vscode/contents/src%2Fvs%2Fworkbench%2Fbrowser%2Fparts%2Factivitybar%2FactivitybarPart.ts?ref=52fa23e8f11fa6bf4759afd87b2721c4de2fc651",
   "patch": "@@ -584,18 +584,20 @@ registerThemingParticipant((theme, collector) => {\n \tconst outline = theme.getColor(activeContrastBorder);\n \tif (outline) {\n \t\tcollector.addRule(`\n-\t\t\t.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item .action-label::before{\n-\t\t\t\tpadding: 6px;\n+\t\t\t.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item .action-label-outline{\n+\t\t\t\tposition: absolute;\n+\t\t\t\tinset: 6px;\n+\t\t\t\tz-index: 2\n \t\t\t}\n \n-\t\t\t.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item.active .action-label::before,\n-\t\t\t.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item.active:hover .action-label::before,\n-\t\t\t.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item.checked .action-label::before,\n-\t\t\t.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item.checked:hover .action-label::before {\n+\t\t\t.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item.active .action-label-outline,\n+\t\t\t.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item.active:hover .action-label-outline,\n+\t\t\t.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item.checked .action-label-outline,\n+\t\t\t.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item.checked:hover .action-label-outline {\n \t\t\t\toutline: 1px solid ${outline};\n \t\t\t}\n \n-\t\t\t.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item:hover .action-label::before {\n+\t\t\t.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item:hover .action-label-outline {\n \t\t\t\toutline: 1px dashed ${outline};\n \t\t\t}\n "
  },
  {
   "sha": "cdfc4f74e7e3f1aef4edd9d77c8ec63f63c7f646",
   "filename": "src/vs/workbench/browser/parts/compositeBarActions.ts",
   "status": "modified",
   "additions": 3,
   "deletions": 0,
   "changes": 3,
   "blob_url": "https://github.com/microsoft/vscode/blob/52fa23e8f11fa6bf4759afd87b2721c4de2fc651/src%2Fvs%2Fworkbench%2Fbrowser%2Fparts%2FcompositeBarActions.ts",
   "raw_url": "https://github.com/microsoft/vscode/raw/52fa23e8f11fa6bf4759afd87b2721c4de2fc651/src%2Fvs%2Fworkbench%2Fbrowser%2Fparts%2FcompositeBarActions.ts",
   "contents_url": "https://api.github.com/repos/microsoft/vscode/contents/src%2Fvs%2Fworkbench%2Fbrowser%2Fparts%2FcompositeBarActions.ts?ref=52fa23e8f11fa6bf4759afd87b2721c4de2fc651",
   "patch": "@@ -282,6 +282,9 @@ export class CompositeBarActionViewItem extends BaseActionViewItem {\n \t\t// pane composite bar active border + background\n \t\tappend(container, $('.active-item-indicator'));\n \n+\t\t// outline\n+\t\tappend(container, $('.action-label-outline'));\n+\n \t\thide(this.badge);\n \n \t\tthis.update();"
  }
