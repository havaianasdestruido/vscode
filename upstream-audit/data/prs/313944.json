   "blob_url": "https://github.com/microsoft/vscode/blob/472754d53b29cb86be91f31c692a584e2b891b33/src%2Fvs%2Fplatform%2Fwindows%2Felectron-main%2FwindowsStateHandler.ts",
   "raw_url": "https://github.com/microsoft/vscode/raw/472754d53b29cb86be91f31c692a584e2b891b33/src%2Fvs%2Fplatform%2Fwindows%2Felectron-main%2FwindowsStateHandler.ts",
