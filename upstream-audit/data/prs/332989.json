   "blob_url": "https://github.com/microsoft/vscode/blob/ac2c05a301a69b9d9e1a952299023732f0962359/src%2Fvs%2Feditor%2Fcontrib%2Fsnippet%2Fbrowser%2Fsnippet.md",
   "raw_url": "https://github.com/microsoft/vscode/raw/ac2c05a301a69b9d9e1a952299023732f0962359/src%2Fvs%2Feditor%2Fcontrib%2Fsnippet%2Fbrowser%2Fsnippet.md",
