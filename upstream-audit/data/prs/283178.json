   "blob_url": "https://github.com/microsoft/vscode/blob/30e3e402f6e8d1f16077fb4cd294b702af3952e9/src%2Fvs%2Fworkbench%2Fcontrib%2Fterminal%2Fcommon%2Fscripts%2FshellIntegration.ps1",
   "raw_url": "https://github.com/microsoft/vscode/raw/30e3e402f6e8d1f16077fb4cd294b702af3952e9/src%2Fvs%2Fworkbench%2Fcontrib%2Fterminal%2Fcommon%2Fscripts%2FshellIntegration.ps1",
   "contents_url": "https://api.github.com/repos/microsoft/vscode/contents/src%2Fvs%2Fworkbench%2Fcontrib%2Fterminal%2Fcommon%2Fscripts%2FshellIntegration.ps1?ref=30e3e402f6e8d1f16077fb4cd294b702af3952e9",
   "patch": "@@ -10,7 +10,19 @@ if ((Test-Path variable:global:__VSCodeState) -and $null -ne $Global:__VSCodeSta\n \n # Disable shell integration when the language mode is restricted\n if ($ExecutionContext.SessionState.LanguageMode -ne \"FullLanguage\") {\n-\treturn;\n+\t$LanguageMode = $ExecutionContext.SessionState.LanguageMode\n+\tif (-not $IsWindows -or $LanguageMode -ne \"ConstrainedLanguage\") {\n+\t\treturn;\n+\t}\n+\ttry {\n+\t\t# Allow ConstrainedLanguage only when Windows lockdown policy is Audit (PS 7.4+).\n+\t\t$Lockdown = [System.Management.Automation.Security.SystemPolicy]::GetSystemLockdownPolicy()\n+\t\tif ($Lockdown -and $Lockdown -ne \"Audit\") {\n+\t\t\treturn;\n+\t\t}\n+\t} catch {\n+\t\treturn;\n+\t}\n }\n \n $Global:__VSCodeState = @{"
  }
 ],
