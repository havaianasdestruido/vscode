   "raw_url": "https://github.com/microsoft/vscode/raw/95ade9b54ef8e8f5fead3778b65276c8be1f0fed/src%2Fvs%2Feditor%2Fcommon%2Flanguages%2Fsupports%2Ftokenization.ts",
   "contents_url": "https://api.github.com/repos/microsoft/vscode/contents/src%2Fvs%2Feditor%2Fcommon%2Flanguages%2Fsupports%2Ftokenization.ts?ref=95ade9b54ef8e8f5fead3778b65276c8be1f0fed",
   "patch": "@@ -415,6 +415,10 @@ export function generateTokensCSSForColorMap(colorMap: readonly Color[]): string\n \t\tconst color = colorMap[i];\n \t\trules[i] = `.mtk${i} { color: ${color}; }`;\n \t}\n+\tfor (let i = 1, len = colorMap.length; i < len; i++) {\n+\t\tconst color = colorMap[i];\n+\t\trules.push(`.mtkbg${i}::before { content: \"\"; position: absolute; top: 0; left: 0; background-color: ${color}; width: 100%; height: 100%; display: flex; z-index: -1; }`);\n+\t}\n \trules.push('.mtki { font-style: italic; }');\n \trules.push('.mtkb { font-weight: bold; }');\n \trules.push('.mtku { text-decoration: underline; text-underline-position: under; }');"
